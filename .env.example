SECRET_KEY=replace-me
DEBUG=False
ALLOWED_HOSTS=your-app.applikuapp.com
CORS_ALLOWED_ORIGINS=https://your-app.applikuapp.com
CSRF_TRUSTED_ORIGINS=https://your-app.applikuapp.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
PORT=8000

# Sentry (optional). Unset locally to disable. Create a Python/Django project in Sentry and paste the DSN.
# SENTRY_DSN=https://...@....ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0

# Contact form (`POST /api/v1/contact/`). Default inbox is pondarbor@gmail.com if unset.
# CONTACT_INBOX_EMAIL=pondarbor@gmail.com
#
# Important: if EMAIL_BACKEND is unset, Django defaults to **console** — the UI still says "sent" but
# no email leaves the server (output is only in app logs). Production must set real SMTP, e.g.:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
#
# Local dev (optional): print messages to the terminal instead:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Auth0 (backend validates API access tokens)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_API_AUDIENCE=https://your-api-identifier

# Slack: use two Slack apps so Auth0 “Sign in with Slack” does not mix OIDC scopes with bot scopes
# (which Slack often rejects as “Invalid permissions requested”).
#
# - **ArborBot** — slash `/song`, Events API, channel posts, ephemerals. Put only this app’s credentials
#   in the variables below (`SLACK_*`). Do not put ArborBot’s OAuth client in Auth0 for login.
# - **pondarbor.com login** — Auth0 Slack social connection only (`openid`, `email`, `profile`). Client ID
#   and secret live in Auth0 (Authentication → Social → Slack), not in this file.
#
# Slack (Song-a-day bot): optional — omit `SLACK_*` to disable server-side Slack.
# SLACK_SIGNING_SECRET=ArborBot: Signing Secret from Slack app "Basic Information"
# SLACK_BOT_TOKEN=xoxb-... from ArborBot (scopes e.g. chat:write, channels:history, commands, users:read, users:read.email)
# SLACK_PROMPTS_CHANNEL_ID=C0123456789
# Optional: restrict passive message parsing to a specific channel (Events API `message.channels`).
# Defaults to SLACK_PROMPTS_CHANNEL_ID if unset.
# SLACK_SONGADAY_CHANNEL_ID=C0123456789
# Optional: private debug channel for ingest failures (recommend a private #arborbot-debug channel).
# When set, ArborBot will post a short message for certain failures (unlinked user, no prompt today, etc.).
# SLACK_DEBUG_CHANNEL_ID=C0123456789
# Link for “Create account” button shown to unlinked users in Slack.
# SLACK_CREATE_ACCOUNT_URL=https://www.pondarbor.com/
# SONGADAY_SLACK_PROMPT_TIMEZONE=America/Phoenix
# Optional: if JWT `iss` is not https://{AUTH0_DOMAIN}/ (e.g. custom domain), set the exact issuer URL including trailing slash.
# AUTH0_ISSUER=https://login.yourdomain.com/

# Cloudflare R2 (closet item photos). Create bucket + API token; attach a custom domain for public reads.
#
# Browser uploads hit *.r2.cloudflarestorage.com directly → CORS is on the R2 bucket (Dashboard → R2 → bucket → Settings → CORS).
# Add every origin that serves your SPA (scheme + host + port must match exactly). Example policy:
# [
#   {
#     "AllowedOrigins": ["http://127.0.0.1:5173", "http://localhost:5173", "http://127.0.0.1:8000", "http://localhost:8000", "https://your-app.example.com"],
#     "AllowedMethods": ["GET", "PUT", "HEAD"],
#     "AllowedHeaders": ["Content-Type"],
#     "ExposeHeaders": ["ETag", "Content-Length"],
#     "MaxAgeSeconds": 3600
#   }
# ]
# GET is useful if you load images from the public bucket URL; PUT is required for presigned uploads.
# CLOUDFLARE_ACCOUNT_ID=
# Optional: full S3 API URL from R2 “jurisdiction-specific endpoints” (use when not using default US endpoint).
# CLOSET_R2_S3_ENDPOINT_URL=https://<accountid>.eu.r2.cloudflarestorage.com
# Optional: set to true if presigned PUT URLs must use path-style signing (try if uploads fail).
# CLOSET_R2_S3_PATH_STYLE=false
# CLOSET_R2_BUCKET=
# CLOSET_R2_ACCESS_KEY_ID=
# CLOSET_R2_SECRET_ACCESS_KEY=
# CLOSET_R2_KEY_PREFIX=closet
# CLOSET_R2_PUBLIC_BASE_URL=https://closet-cdn.yourdomain.com
# CLOSET_IMAGE_MAX_BYTES=1048576
# CLOSET_UPLOAD_EXPIRES_SECONDS=900
#
# Meal Maestro recipe photos use the same R2 bucket and CLOSET_R2_PUBLIC_BASE_URL; keys are under MEAL_R2_KEY_PREFIX.
# MEAL_R2_KEY_PREFIX=meal
# MEAL_IMAGE_MAX_BYTES=2097152
# MEAL_PAPRIKA_IMPORT_MAX_BYTES=52428800
# MEAL_PAPRIKA_IMPORT_MAX_RECIPES=500
