# Leave empty for local dev: same-origin /api via Vite proxy (no CORS).
# Or set full backend URL e.g. http://127.0.0.1:8000 (Django CORS must allow the SPA origin).
VITE_API_BASE_URL=

# Auth0 (required for local Vite dev). On Appliku/Docker production, the same values can live as
# app env vars; Django injects them into the HTML shell at runtime (no Vite rebuild needed).
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_API_AUDIENCE=https://your-api-identifier

# Optional: Auth0 social connection name for Slack (Dashboard → Authentication → Social → Slack).
# When set, “Log in / Sign up with Slack” buttons appear on the home and nav menus.
# That connection should use a **separate** Slack app (e.g. **pondarbor.com login**) with only user
# scopes `openid`, `email`, `profile` — not the **ArborBot** app used for `/song` and channel integration.
# VITE_AUTH0_SLACK_CONNECTION=slack

# Sentry is production-only: set SENTRY_DSN on the server (Appliku env). Django injects it into the
# HTML shell at runtime — no frontend env vars needed for local dev.
